rules_version = '2';

// =====================================================================
// PROPOSTA — regras do RASTREL (projeto rastreabilidade-a511a)
// NÃO PUBLICADA. Testada no emulador (tests/regras-modulos.test.mjs).
// Substitui: match /{document=**} { allow read, write: if request.auth != null; }
//
// Antes de publicar: criar usuarios/{uid} para cada uma das 4 contas
// atuais (nome, email, perfil, ativo:true). Sem esse cadastro, a conta
// perde o acesso.
// Perfis:
//   administrador — tudo, inclusive apagar dados e gerenciar usuários
//   operador      — cria bags, vincula/substitui tag, movimenta, confere carga
//   visualizador  — só consulta
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function cadastro() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function ativo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && cadastro().ativo == true;
    }
    function temPerfil(perfis) { return ativo() && cadastro().perfil in perfis; }
    function admin() { return temPerfil(['administrador']); }
    function opera() { return temPerfil(['administrador', 'operador']); }

    function usuarioValido(u) {
      return u.keys().hasAll(['nome', 'email', 'perfil', 'ativo'])
        && u.nome is string && u.email is string && u.ativo is bool
        && u.perfil in ['administrador', 'operador', 'visualizador'];
    }

    match /usuarios/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if admin() && usuarioValido(request.resource.data);
      allow delete: if admin() && uid != request.auth.uid;
    }

    // bags: operador cria e atualiza; apagar (inclui "apagar tudo") só administrador
    match /bags/{id} {
      allow read: if ativo();
      allow create: if opera() && request.resource.data.lote is string;
      allow update: if opera();
      allow delete: if admin();
    }

    // tags NFC: registro de unicidade. Tag criada nunca é apagada por operador
    // (uma tag não pode ser reutilizada); marcar como substituída é permitido.
    match /epcs/{epc} {
      allow read: if ativo();
      allow create: if opera() && request.resource.data.epc == epc;
      allow update: if opera() && request.resource.data.epc == epc;
      allow delete: if admin();
    }

    // eventos dos bags: só acrescenta; corrigir/apagar só administrador
    match /movimentacoes/{id} {
      allow read: if ativo();
      allow create: if opera();
      allow update, delete: if admin();
    }

    // ordens de carga (expedição) e bags conferidos em cada uma
    match /pedidos_carga/{oc} {
      allow read: if ativo();
      allow create, update: if opera();
      allow delete: if admin();
      match /itens/{item} {
        allow read: if ativo();
        allow create: if opera();
        allow update, delete: if admin();
      }
    }

    // mapa dos armazéns (Armazém 2 e Garagem)
    match /mapa/{doc} {
      allow read: if ativo();
      allow write: if opera();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
